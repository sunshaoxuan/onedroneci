# 复制为 drone.env 后填写真实值。
# Web 访问地址：http://192.168.20.54:3838

DRONE_GITLAB_SERVER=https://upds7.ujob100.com
DRONE_GITLAB_CLIENT_ID=从 GitLab OAuth Application 复制
DRONE_GITLAB_CLIENT_SECRET=从 GitLab OAuth Application 复制

# 生成方式示例：openssl rand -hex 16
# 注意：docker-compose.yml 里的 runner 也会读取同一个值。
DRONE_RPC_SECRET=请替换为随机字符串

DRONE_SERVER_HOST=192.168.20.54:3838
DRONE_SERVER_PROTO=http

# 第一个管理员账号。username 必须填写你的 GitLab 用户名，不是邮箱。
DRONE_USER_CREATE=username:你的GitLab用户名,admin:true

DRONE_DATABASE_DRIVER=sqlite3
DRONE_DATABASE_DATASOURCE=/data/database.sqlite

# 第一版先关闭注册，只允许 GitLab 已授权/管理员控制。
DRONE_USER_FILTER=你的GitLab用户名
