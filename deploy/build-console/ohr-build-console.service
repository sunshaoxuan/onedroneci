[Unit]
Description=OHR Build Console
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/ohr-build-console
EnvironmentFile=/opt/ohr-build-console/build-console.env
ExecStart=/usr/bin/python3 /opt/ohr-build-console/server.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
