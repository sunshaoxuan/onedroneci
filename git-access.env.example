# 复制为 git-access.env（已在 .gitignore）后填写真实值。
# Maven 私服（与 ohr-back pom 中 distributionManagement 对齐）
MAVEN_ONEHR_USERNAME=admin
MAVEN_ONEHR_PASSWORD=你的私服密码

# GitLab 拉取 ohr-back 用的 token（脚本会写入 oauth2 URL，注意 PAT 含 # 时需 URL 编码）
OHR_BACK_GIT_TOKEN=

# 每次打包要检出的后端分支（可被脚本/命令行覆盖）
OHR_BACK_BRANCH=release_20260129

# 前端 ohr-workspace 分支（测试可与后端同名；留空时 smoke 脚本会回退 master）
FRONTEND_WORKSPACE_BRANCH=release_20260129
FRONTEND_RELEASE_BRANCH=release_20260129
