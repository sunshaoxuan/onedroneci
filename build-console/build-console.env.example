# 复制为 build-console.env 后部署到 /opt/ohr-build-console。
BUILD_CONSOLE_HOST=0.0.0.0
BUILD_CONSOLE_PORT=8090
BUILD_CONSOLE_DATA_DIR=/opt/ohr-build-console/builds
BUILD_ARTIFACT_ROOT=/opt/ohr-build-artifacts
BUILD_EXECUTOR=direct
OHR_BACK_DIR=/root/ohr-back

# GitLab 拉取 ohr-back 使用；如果远端 origin 已有可用凭据，可留空。
OHR_BACK_GIT_TOKEN=

# Maven 私服凭据。
MAVEN_ONEHR_USERNAME=admin
MAVEN_ONEHR_PASSWORD=你的私服密码

# 第二阶段 Drone 执行器配置。切换时设置 BUILD_EXECUTOR=drone。
DRONE_SERVER_URL=http://127.0.0.1:8080
DRONE_TOKEN=
DRONE_CONTROL_REPO=sunshaoxuan/ohr-build-control
DRONE_CONTROL_BRANCH=master

# direct 模式前端：默认拉取 ohr/ohr-workspace；可与 OHR_BACK_GIT_TOKEN 共用 PAT。
FRONTEND_WORKSPACE_GIT_URL=https://upds7.ujob100.com/ohr/ohr-workspace.git
FRONTEND_WORKSPACE_BRANCH=master
FRONTEND_WORKSPACE_DIR=/opt/ohr-workspace-src
FRONTEND_FEELIN_GIT_URL=https://upds7.ujob100.com/ohr/ohr-feelin.git
FRONTEND_LOWCODE_ENGINE_GIT_URL=https://upds7.ujob100.com/ohr/ohr-lowcode-engine.git
FRONTEND_MICRO_FRONTENDS_GIT_URL=https://upds7.ujob100.com/ohr/ohr-micro-frontends.git
FRONTEND_NOCODE_ENGINE_GIT_URL=https://upds7.ujob100.com/ohr/ohr-nocode-engine.git
FRONTEND_GIT_TOKEN=
# NPM 私服 _auth（Base64）；留空则用 MAVEN_ONEHR_USERNAME:PASSWORD 生成。
NPM_AUTH_B64=

# direct 模式前端：conf_prod HTTP 模板目录。
CONF_PROD_TEMPLATE_DIR=/opt/ohr-build-console/conf_prod_template

# 宿主机最终安装包外壳配置（host_standalone_console.py 使用）。
REMOTE_BUILD_CONSOLE_URL=http://192.168.250.50:8090
STANDALONE_OUTPUT_DIR=D:\workspace\droneci\dist\standalone
STANDALONE_TEMPLATE_ZIP=D:\workspace\droneci\.standalone-template\OneHrStandalone.zip
STANDALONE_SQL_TEMPLATE_DIR=D:\workspace\droneci\.standalone-template\sql
HOST_STANDALONE_CONSOLE_HOST=0.0.0.0
HOST_STANDALONE_CONSOLE_PORT=8091
