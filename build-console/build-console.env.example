# 复制为 build-console.env 后部署到 /opt/ohr-build-console。
BUILD_CONSOLE_HOST=0.0.0.0
BUILD_CONSOLE_PORT=8090
BUILD_CONSOLE_DATA_DIR=/opt/ohr-build-console/builds
BUILD_ARTIFACT_ROOT=/opt/ohr-build-artifacts
BUILD_EXECUTOR=direct
OHR_BACK_DIR=/root/ohr-back

# GitLab 拉取 ohr-back 使用；如果远端 origin 已有可用凭据，可留空。
OHR_BACK_GIT_TOKEN=

# Maven 私服凭据。
MAVEN_ONEHR_USERNAME=admin
MAVEN_ONEHR_PASSWORD=你的私服密码

# 第二阶段 Drone 执行器配置。切换时设置 BUILD_EXECUTOR=drone。
DRONE_SERVER_URL=http://127.0.0.1:8080
DRONE_TOKEN=
DRONE_CONTROL_REPO=sunshaoxuan/ohr-build-control
DRONE_CONTROL_BRANCH=master

# direct 模式前端：默认拉取 ohr/ohr-workspace；可与 OHR_BACK_GIT_TOKEN 共用 PAT。
FRONTEND_WORKSPACE_GIT_URL=https://upds7.ujob100.com/ohr/ohr-workspace.git
FRONTEND_WORKSPACE_BRANCH=master
FRONTEND_WORKSPACE_DIR=/opt/ohr-workspace-src
FRONTEND_FEELIN_GIT_URL=https://upds7.ujob100.com/ohr/ohr-feelin.git
FRONTEND_LOWCODE_ENGINE_GIT_URL=https://upds7.ujob100.com/ohr/ohr-lowcode-engine.git
FRONTEND_MICRO_FRONTENDS_GIT_URL=https://upds7.ujob100.com/ohr/ohr-micro-frontends.git
FRONTEND_NOCODE_ENGINE_GIT_URL=https://upds7.ujob100.com/ohr/ohr-nocode-engine.git
FRONTEND_GIT_TOKEN=
# NPM 私服 _auth（Base64）；留空则用 MAVEN_ONEHR_USERNAME:PASSWORD 生成。
NPM_AUTH_B64=

# NHO版 direct 模式：与標準版完全隔离的仓库、工作区与缓存。
NHO_BACK_DIR=/root/nho-ohr-back
NHO_BACK_GIT_URL=https://upds7.ujob100.com/nhophr/ohr-back.git
NHO_FRONTEND_WORKSPACE_GIT_URL=https://upds7.ujob100.com/nhophr/ohr-workspace.git
NHO_FRONTEND_WORKSPACE_BRANCH=master
NHO_FRONTEND_WORKSPACE_DIR=/opt/nho-ohr-workspace-src
NHO_FRONTEND_FEELIN_GIT_URL=https://upds7.ujob100.com/nhophr/ohr-feelin.git
NHO_FRONTEND_FEELIN_BRANCH=master
NHO_FRONTEND_MICRO_FRONTENDS_GIT_URL=https://upds7.ujob100.com/nhophr/ohr-micro-frontends.git
NHO_FRONTEND_LOWCODE_ENGINE_GIT_URL=https://upds7.ujob100.com/nhophr/ohr-lowcode-engine.git
NHO_FRONTEND_NOCODE_ENGINE_GIT_URL=https://upds7.ujob100.com/nhophr/ohr-nocode-engine.git
NHO_FRONTEND_NENCHO_GIT_URL=https://upds7.ujob100.com/nhophr/ohr-web-nencho.git
NHO_PNPM_CACHE_DIR=/opt/nho-pnpm-cache
NHO_MATERIAL_SVN_URL=http://3.115.155.21/svn/nho4phr/大連側/97.リリース作業
NHO_MATERIAL_SVN_USERNAME=
NHO_MATERIAL_SVN_PASSWORD=
NHO_MATERIAL_CACHE_SECONDS=300

# direct 模式前端：help 使用 ohr-help-docs + SVN 增量同步；conf_prod 使用 ohr-cicd generateConf.js 生成。
HELP_DOCS_GIT_URL=https://upds7.ujob100.com/ohr/ohr-help-docs.git
HELP_DOCS_BRANCH=release_ci
HELP_DOCS_DIR=/opt/ohr-help-docs-src
HELP_DOCS_SVN_URL=http://192.168.21.111/svn/PHR1.5/30.マニュアル/マニュアル(日本語版)
HELP_DOCS_SVN_DIR=/opt/ohr-help-docs-svn
HELP_DOCS_SVN_USERNAME=
HELP_DOCS_SVN_PASSWORD=
OHR_CICD_GIT_URL=https://upds7.ujob100.com/ohr/ohr-cicd.git
OHR_CICD_BRANCH=master
OHR_CICD_DIR=/opt/ohr-cicd-src
OHR_CICD_ENV=direct_prod
OHR_CICD_SERVICE_GATEWAY=http://localhost:3198/
OHR_CICD_MINIO_SERVER=http://localhost:19000
OHR_CICD_MINIO_HOST=localhost:19000
OHR_CICD_RUSTFS_SERVER=http://127.0.0.1:12345
OHR_CICD_RUSTFS_HOST=127.0.0.1:12345

# 旧版 direct conf_prod 模板目录，保留给回滚和排障使用。
CONF_PROD_TEMPLATE_DIR=/opt/ohr-build-console/conf_prod_template

# 宿主机最终安装包外壳配置（host_standalone_console.py 使用）。
REMOTE_BUILD_CONSOLE_URL=http://192.168.250.50:8090
STANDALONE_OUTPUT_DIR=D:\workspace\droneci\dist\standalone
STANDALONE_TEMPLATE_ZIP=D:\workspace\droneci\.standalone-template\OneHrStandalone.zip
STANDALONE_SQL_TEMPLATE_DIR=D:\workspace\droneci\.standalone-template\sql
STANDALONE_SQL_SVN_URL=http://192.168.21.111/svn/PHR1.5/98.環境構築手順書/1.構築製品共通
DATA_SYNC_GIT_URL=https://upds7.ujob100.com/ohr/data-synchronization.git
DATA_SYNC_BRANCH=master
DATA_SYNC_DIR=D:\workspace\droneci\.standalone-template\data-synchronization
DATA_SYNC_SUBDIR=updsv7phr/PHR
HOST_STANDALONE_CONSOLE_HOST=0.0.0.0
HOST_STANDALONE_CONSOLE_PORT=8091
